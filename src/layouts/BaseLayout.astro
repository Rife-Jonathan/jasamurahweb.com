---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import FloatingWhatsapp from '@components/FloatingWhatsapp.astro';
import { contact } from '@data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** URL gambar untuk Open Graph (opsional, default ke gambar site) */
  ogImage?: string;
  /** URL canonical eksplisit (opsional, default ke URL halaman saat ini) */
  canonicalUrl?: string;
}

const {
  title,
  description,
  ogImage = '/og-image.png',
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://www.jasamurahweb.com';
const currentUrl = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'jasamurahweb.com',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#logo`,
    url: `${siteUrl}/logo-jasamurabweb.png`,
    width: 200,
    height: 60,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: contact.whatsappDisplay,
    contactType: 'customer service',
    availableLanguage: 'Indonesian',
  },
  sameAs: [contact.instagram, contact.facebook],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'jasamurahweb.com',
  url: siteUrl,
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: 'id-ID',
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${siteUrl}/#localbusiness`,
  name: 'jasamurahweb.com',
  url: siteUrl,
  telephone: contact.whatsappDisplay,
  email: contact.email,
  image: `${siteUrl}/og-image.png`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Candi Gebang permai blok 6 no 2 Jetis, Wedomartani',
    addressLocality: 'Sleman',
    addressRegion: 'Yogyakarta',
    postalCode: '55584',
    addressCountry: 'ID',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -7.7397,
    longitude: 110.4269,
  },
  areaServed: { '@type': 'Country', name: 'Indonesia' },
  sameAs: [contact.instagram, contact.facebook],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="jasamurahweb.com" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} is:inline />

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="theme-color" content="#0052CC" />

    <!-- Fonts self-hosted via fontsource — diimport dari global.css -->

    <!-- Dark mode init (inline agar tidak flicker) -->
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-white text-zinc-950 dark:bg-zinc-950 dark:text-zinc-200">
    <Header />
    <main>
      <slot />
    </main>
    <FloatingWhatsapp />
    <Footer />
  </body>
</html>

