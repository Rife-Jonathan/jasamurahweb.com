---
import Button from '@components/Button.astro';
import { getWebsiteCityPath, priorityWebsiteCityPages, websiteCityPages } from '@data/websiteCities';

interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  limit?: number;
  showCta?: boolean;
}

const {
  eyebrow = 'Area layanan',
  title = 'Area Layanan Jasa Pembuatan Website',
  description = 'Kami membantu bisnis di berbagai kota menyusun website dengan halaman layanan, CTA WhatsApp, basic SEO, katalog/company profile, dan alur konsultasi yang jelas sesuai kebutuhan lokal.',
  limit,
  showCta = true,
} = Astro.props;

const sourceCities = typeof limit === 'number' ? priorityWebsiteCityPages : websiteCityPages;
const visibleCities = typeof limit === 'number' ? sourceCities.slice(0, limit) : sourceCities;
---

<section class="premium-section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-3xl">
        <p class="premium-eyebrow">{eyebrow}</p>
        <h2 class="mt-4 text-3xl font-black tracking-[-0.035em] text-zinc-950 dark:text-white sm:text-4xl">{title}</h2>
        <p class="mt-5 text-base leading-relaxed text-zinc-600 dark:text-zinc-300">{description}</p>
      </div>
      {showCta && <Button href="/area-layanan/" variant="secondary" class="shrink-0">Lihat Semua Area</Button>}
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {visibleCities.map((item) => (
        <a
          href={getWebsiteCityPath(item)}
          class="premium-card premium-card-hover group p-5"
        >
          <span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-brand dark:bg-brand/10 dark:text-teal-200">{item.province}</span>
          <h3 class="mt-4 text-lg font-black tracking-tight text-zinc-950 transition group-hover:text-brand dark:text-white dark:group-hover:text-teal-200">
            Jasa Pembuatan Website {item.city}
          </h3>
          <p class="mt-3 line-clamp-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">{item.introAngle}</p>
        </a>
      ))}
    </div>
  </div>
</section>
