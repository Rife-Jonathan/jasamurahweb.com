---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'light';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
const base =
  'font-accent inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-bold transition duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:translate-y-px';
const variants = {
  primary: 'bg-zinc-950 text-white shadow-[0_14px_36px_rgba(15,23,42,0.18)] hover:-translate-y-0.5 hover:bg-zinc-800 focus-visible:outline-brand dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-100',
  secondary: 'border border-zinc-200/90 bg-white/75 text-zinc-950 shadow-sm backdrop-blur-xl hover:-translate-y-0.5 hover:border-brand/45 hover:text-brand hover:shadow-glow focus-visible:outline-brand dark:border-white/10 dark:bg-white/[0.06] dark:text-white dark:hover:border-brand/50 dark:hover:text-teal-200',
  light: 'bg-white text-zinc-950 shadow-sm hover:-translate-y-0.5 hover:bg-brand-50 focus-visible:outline-white dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white',
};
---

{
  href ? (
    <a href={href} class={`${base} ${variants[variant]} ${className}`}>
      <slot />
    </a>
  ) : (
    <button class={`${base} ${variants[variant]} ${className}`}>
      <slot />
    </button>
  )
}
