---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'light';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
const base =
  'inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2';
const variants = {
  primary: 'bg-brand text-white shadow-sm shadow-blue-900/15 hover:bg-brand-700 focus-visible:outline-brand',
  secondary: 'border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900/50 text-zinc-950 dark:text-white hover:border-brand dark:hover:border-blue-500 hover:text-brand dark:hover:text-blue-500 focus-visible:outline-brand',
  light: 'bg-white text-brand hover:bg-brand-50 focus-visible:outline-white dark:bg-zinc-100 dark:hover:bg-zinc-200',
};
---

{
  href ? (
    <a href={href} class={`${base} ${variants[variant]} ${className}`}>
      <slot />
    </a>
  ) : (
    <button class={`${base} ${variants[variant]} ${className}`}>
      <slot />
    </button>
  )
}
