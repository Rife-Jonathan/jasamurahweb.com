---
const { issueHighlights } = Astro.props;
---
<div class="relative flex items-center justify-center lg:justify-end">
  <div class="pointer-events-none absolute -right-14 -top-14 h-64 w-64 rounded-full bg-indigo-500/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-16 -left-10 h-56 w-56 rounded-full bg-violet-400/30 blur-3xl"></div>
  
  {/* Floating Badges */}
  <div class="service-float absolute -right-4 top-10 z-20 hidden rounded-2xl bg-indigo-600 px-4 py-3 shadow-xl sm:block">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-indigo-100">Active Users</p>
    <p class="mt-1 flex items-baseline gap-1 text-2xl font-extrabold text-white">12.5<span class="text-sm font-bold text-indigo-200">k</span></p>
  </div>
  
  <div class="service-float absolute -left-6 bottom-12 z-20 hidden rounded-2xl border border-zinc-100 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-4 py-3 shadow-2xl sm:block" style="animation-delay: 1.5s;">
    <div class="flex items-center gap-3">
      <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" /></svg>
      </div>
      <div>
        <p class="text-xs font-bold text-zinc-900 dark:text-white">Retention</p>
        <p class="text-[11px] text-emerald-600 dark:text-emerald-400">+24% This week</p>
      </div>
    </div>
  </div>

  {/* Mobile App Frame */}
  <div class="relative z-10 w-[280px] h-[560px] overflow-hidden rounded-[2.5rem] border-8 border-zinc-900 bg-zinc-50 dark:bg-zinc-950 shadow-[0_30px_80px_rgba(0,0,0,0.15)] ring-1 ring-white/10">
    {/* Notch */}
    <div class="absolute left-1/2 top-0 h-6 w-32 -translate-x-1/2 rounded-b-3xl bg-zinc-900"></div>
    
    {/* App UI */}
    <div class="flex h-full w-full flex-col pt-10">
      {/* Header */}
      <div class="px-5 py-4">
        <div class="flex items-center justify-between">
          <div>
            <div class="h-3 w-20 rounded bg-zinc-200 dark:bg-zinc-800"></div>
            <div class="mt-2 h-5 w-32 rounded bg-zinc-800 dark:bg-zinc-200"></div>
          </div>
          <div class="h-10 w-10 rounded-full bg-indigo-100 dark:bg-indigo-900/30"></div>
        </div>
      </div>
      
      {/* Chart Area */}
      <div class="px-5 py-2">
        <div class="h-[140px] w-full rounded-2xl border border-zinc-100 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4 shadow-sm relative overflow-hidden">
           <div class="h-3 w-16 rounded bg-zinc-200 dark:bg-zinc-700 mb-4"></div>
           <div class="flex h-16 items-end gap-2">
              <div class="w-1/6 rounded-t bg-indigo-100 dark:bg-indigo-900/40" style="height: 40%"></div>
              <div class="w-1/6 rounded-t bg-indigo-200 dark:bg-indigo-900/60" style="height: 60%"></div>
              <div class="w-1/6 rounded-t bg-indigo-300 dark:bg-indigo-800/60" style="height: 45%"></div>
              <div class="w-1/6 rounded-t bg-indigo-400 dark:bg-indigo-700/60" style="height: 80%"></div>
              <div class="w-1/6 rounded-t bg-indigo-500 dark:bg-indigo-600/80" style="height: 65%"></div>
              <div class="w-1/6 rounded-t bg-indigo-600 dark:bg-indigo-500" style="height: 95%"></div>
           </div>
        </div>
      </div>

      {/* List Area */}
      <div class="flex-1 px-5 py-4 space-y-3">
        {issueHighlights && issueHighlights.slice(0, 3).map((_: any, idx: number) => (
          <div class="mockup-item flex items-center gap-4 rounded-xl bg-white dark:bg-zinc-900 p-3 shadow-sm border border-zinc-100 dark:border-zinc-800" style={`animation-delay: ${0.5 + idx * 0.2}s; opacity: 0; animation-fill-mode: forwards;`}>
            <div class="h-10 w-10 rounded-xl bg-indigo-50 dark:bg-indigo-900/20"></div>
            <div class="flex-1">
              <div class="h-3 w-full rounded bg-zinc-800 dark:bg-zinc-300"></div>
              <div class="mt-2 h-2 w-1/2 rounded bg-zinc-300 dark:bg-zinc-700"></div>
            </div>
          </div>
        ))}
      </div>
      
      {/* Bottom Nav */}
      <div class="mt-auto flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-6 py-4 pb-8">
        <div class="h-6 w-6 rounded bg-indigo-600 dark:bg-indigo-500"></div>
        <div class="h-6 w-6 rounded bg-zinc-200 dark:bg-zinc-700"></div>
        <div class="h-6 w-6 rounded bg-zinc-200 dark:bg-zinc-700"></div>
        <div class="h-6 w-6 rounded bg-zinc-200 dark:bg-zinc-700"></div>
      </div>
    </div>
  </div>
</div>
