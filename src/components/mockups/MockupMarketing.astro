---
const { issueHighlights } = Astro.props;
---
<div class="relative flex items-center justify-center lg:justify-end">
  <div class="pointer-events-none absolute -right-14 -top-14 h-64 w-64 rounded-full bg-orange-500/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-16 -left-10 h-56 w-56 rounded-full bg-amber-400/30 blur-3xl"></div>
  
  {/* Floating Badges */}
  <div class="service-float absolute -right-4 top-10 z-20 hidden rounded-2xl bg-orange-600 px-4 py-3 shadow-xl sm:block">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-orange-100">ROAS</p>
    <p class="mt-1 flex items-baseline gap-1 text-2xl font-extrabold text-white">4.8<span class="text-sm font-bold text-orange-200">x</span></p>
  </div>
  
  <div class="service-float absolute -left-6 bottom-12 z-20 hidden rounded-2xl border border-zinc-100 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-4 py-3 shadow-2xl sm:block" style="animation-delay: 1.5s;">
    <div class="flex items-center gap-3">
      <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path d="M12 9a1 1 0 01-1-1V3c0-.553.448-1 1-1s1 .447 1 1v5a1 1 0 01-1 1zm-4 4a1 1 0 01-1-1V7c0-.552.448-1 1-1s1 .448 1 1v5a1 1 0 01-1 1zm8-8a1 1 0 01-1-1V5c0-.552.448-1 1-1s1 .448 1 1v0a1 1 0 01-1 1zm-4 12a1 1 0 01-1-1v-5c0-.552.448-1 1-1s1 .448 1 1v5a1 1 0 01-1 1zm-4 0a1 1 0 01-1-1v-3c0-.552.448-1 1-1s1 .448 1 1v3a1 1 0 01-1 1z"/></svg>
      </div>
      <div>
        <p class="text-xs font-bold text-zinc-900 dark:text-white">Conversion</p>
        <p class="text-[11px] text-zinc-500 dark:text-zinc-400">85 Leads Today</p>
      </div>
    </div>
  </div>

  {/* Dashboard Frame */}
  <div class="relative z-10 w-full max-w-md overflow-hidden rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-950 shadow-[0_30px_80px_rgba(0,0,0,0.12)]">
    <div class="border-b border-zinc-100 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-5 py-4">
      <div class="flex items-center justify-between">
        <div class="h-4 w-32 rounded bg-zinc-200 dark:bg-zinc-700"></div>
        <div class="flex gap-2">
          <div class="h-6 w-16 rounded-full bg-zinc-200 dark:bg-zinc-700"></div>
          <div class="h-6 w-16 rounded-full bg-orange-100 dark:bg-orange-900/40 text-[10px] font-bold text-orange-600 dark:text-orange-400 flex items-center justify-center">Active</div>
        </div>
      </div>
    </div>
    
    <div class="p-5">
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="rounded-xl border border-zinc-100 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 p-4">
           <div class="h-3 w-16 rounded bg-zinc-300 dark:bg-zinc-600 mb-3"></div>
           <div class="h-6 w-24 rounded bg-zinc-800 dark:bg-zinc-200 mb-2"></div>
           <div class="h-2 w-12 rounded bg-emerald-400"></div>
        </div>
        <div class="rounded-xl border border-zinc-100 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 p-4">
           <div class="h-3 w-20 rounded bg-zinc-300 dark:bg-zinc-600 mb-3"></div>
           <div class="h-6 w-20 rounded bg-zinc-800 dark:bg-zinc-200 mb-2"></div>
           <div class="h-2 w-16 rounded bg-emerald-400"></div>
        </div>
      </div>
      
      {/* Funnel/Bar Chart */}
      <div class="space-y-4">
        {['Impressions', 'Clicks', 'Leads'].map((label, idx) => {
          const widths = ['95%', '45%', '15%'];
          return (
          <div class="mockup-item" style={`animation-delay: ${0.4 + idx * 0.2}s; opacity: 0; animation-fill-mode: forwards;`}>
            <div class="flex justify-between mb-1.5">
              <span class="text-[10px] font-semibold text-zinc-500 dark:text-zinc-400">{label}</span>
              <span class="text-[10px] font-bold text-zinc-700 dark:text-zinc-300">{(10 - idx * 3)}k</span>
            </div>
            <div class="h-3 w-full rounded-full bg-zinc-100 dark:bg-zinc-800">
              <div class="h-full rounded-full bg-gradient-to-r from-orange-400 to-orange-500" style={`width: ${widths[idx]};`}></div>
            </div>
          </div>
        )})}
      </div>
    </div>
  </div>
</div>
