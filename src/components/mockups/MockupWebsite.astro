---
const { issueHighlights } = Astro.props;
---
<div class="relative flex items-center justify-center lg:justify-end">
  <div class="pointer-events-none absolute -right-14 -top-14 h-64 w-64 rounded-full bg-brand/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-16 -left-10 h-56 w-56 rounded-full bg-blue-300/30 blur-3xl"></div>
  
  {/* Floating Badges */}
  <div class="service-float absolute -right-4 top-10 z-20 hidden rounded-2xl bg-brand px-4 py-3 shadow-xl sm:block">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-blue-100">Performance</p>
    <p class="mt-1 flex items-baseline gap-1 text-2xl font-extrabold text-white">99<span class="text-sm font-bold text-blue-200">%</span></p>
  </div>
  
  <div class="service-float absolute -left-6 bottom-12 z-20 hidden rounded-2xl border border-zinc-100 bg-white dark:bg-zinc-900 dark:border-zinc-800 px-4 py-3 shadow-2xl sm:block" style="animation-delay: 1.5s;">
    <div class="flex items-center gap-3">
      <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
      </div>
      <div>
        <p class="text-xs font-bold text-zinc-900 dark:text-white">Sistem Aktif</p>
        <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Berjalan normal</p>
      </div>
    </div>
  </div>

  {/* Browser Chrome Frame */}
  <div class="relative z-10 w-full max-w-md overflow-hidden rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-950 shadow-[0_30px_80px_rgba(0,0,0,0.12)]">
    {/* Dots macOS style */}
    <div class="flex items-center gap-3 border-b border-zinc-100 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-4 py-3">
      <div class="flex gap-1.5">
        <div class="h-3 w-3 rounded-full bg-rose-400"></div>
        <div class="h-3 w-3 rounded-full bg-amber-400"></div>
        <div class="h-3 w-3 rounded-full bg-emerald-400"></div>
      </div>
      <div class="flex-1 rounded-lg border border-zinc-200/80 dark:border-zinc-700 bg-white dark:bg-zinc-950 px-3 py-1.5 text-center text-[11px] font-medium text-zinc-400">
        app.jasamurahweb.com
      </div>
    </div>
    
    {/* App UI */}
    <div class="flex h-[360px] w-full bg-zinc-50 dark:bg-zinc-900/50">
      {/* Sidebar */}
      <div class="w-[120px] border-r border-zinc-100 dark:border-zinc-800 bg-white dark:bg-zinc-950 p-4">
        <div class="mb-6 h-6 w-16 rounded-md bg-zinc-200 dark:bg-zinc-800"></div>
        <div class="space-y-3">
          <div class="h-4 w-full rounded-md bg-brand/10 dark:bg-brand/20"></div>
          <div class="h-4 w-3/4 rounded-md bg-zinc-100 dark:bg-zinc-800"></div>
          <div class="h-4 w-5/6 rounded-md bg-zinc-100 dark:bg-zinc-800"></div>
          <div class="h-4 w-full rounded-md bg-zinc-100 dark:bg-zinc-800"></div>
        </div>
      </div>
      
      {/* Main Content */}
      <div class="flex-1 p-5">
        <div class="mb-6">
          <div class="h-5 w-32 rounded-md bg-zinc-800 dark:bg-zinc-200"></div>
          <div class="mt-2 h-3 w-48 rounded-md bg-zinc-300 dark:bg-zinc-700"></div>
        </div>
        
        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="rounded-xl border border-zinc-100 dark:border-zinc-800 bg-white dark:bg-zinc-950 p-3 shadow-sm">
            <div class="mb-2 h-3 w-12 rounded bg-zinc-200 dark:bg-zinc-800"></div>
            <div class="service-signal-bar h-2 rounded-full bg-brand" style="--bar-width: 85%; --bar-delay: 0.2s;"></div>
          </div>
          <div class="rounded-xl border border-zinc-100 dark:border-zinc-800 bg-white dark:bg-zinc-950 p-3 shadow-sm">
            <div class="mb-2 h-3 w-16 rounded bg-zinc-200 dark:bg-zinc-800"></div>
            <div class="service-signal-bar h-2 rounded-full bg-amber-400" style="--bar-width: 60%; --bar-delay: 0.4s;"></div>
          </div>
        </div>
        
        <div class="space-y-3">
          {issueHighlights && issueHighlights.slice(0, 3).map((_: any, idx: number) => (
            <div class="mockup-item flex items-center gap-3 rounded-lg border border-zinc-100 dark:border-zinc-800 bg-white dark:bg-zinc-950 p-2.5 shadow-sm" style={`animation-delay: ${0.5 + idx * 0.2}s; opacity: 0; animation-fill-mode: forwards;`}>
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand/10 dark:bg-brand/20 text-brand">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
              </div>
              <div class="flex-1">
                <div class="h-2.5 w-full rounded bg-zinc-700 dark:bg-zinc-300"></div>
                <div class="mt-1.5 h-2 w-2/3 rounded bg-zinc-300 dark:bg-zinc-700"></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
