---
const { issueHighlights } = Astro.props;
---
<div class="relative flex items-center justify-center lg:justify-end">
  <div class="pointer-events-none absolute -right-14 -top-14 h-64 w-64 rounded-full bg-pink-500/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-16 -left-10 h-56 w-56 rounded-full bg-purple-400/30 blur-3xl"></div>
  
  {/* Floating Badges */}
  <div class="service-float absolute -right-4 top-10 z-20 hidden rounded-2xl bg-pink-600 px-4 py-3 shadow-xl sm:block">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-pink-100">Engagement</p>
    <p class="mt-1 flex items-baseline gap-1 text-2xl font-extrabold text-white">8.5<span class="text-sm font-bold text-pink-200">%</span></p>
  </div>
  
  {/* Calendar Frame */}
  <div class="relative z-10 w-full max-w-md overflow-hidden rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-950 shadow-[0_30px_80px_rgba(0,0,0,0.12)]">
    <div class="border-b border-zinc-100 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-5 py-4">
      <div class="flex items-center justify-between">
        <div class="h-5 w-32 rounded bg-zinc-800 dark:bg-zinc-200"></div>
        <div class="flex gap-1">
          <div class="h-6 w-6 rounded-md bg-zinc-200 dark:bg-zinc-700"></div>
          <div class="h-6 w-6 rounded-md bg-zinc-200 dark:bg-zinc-700"></div>
        </div>
      </div>
    </div>
    
    <div class="p-4">
      {/* Week days */}
      <div class="grid grid-cols-7 gap-1 mb-2">
        {['M','T','W','T','F','S','S'].map((d) => (
          <div class="text-center text-[9px] font-bold text-zinc-400 dark:text-zinc-500">{d}</div>
        ))}
      </div>
      
      {/* Calendar Grid */}
      <div class="grid grid-cols-7 gap-1">
        {Array.from({length: 14}).map((_, i) => (
          <div class={`aspect-square rounded border border-zinc-100 dark:border-zinc-800 p-1 flex flex-col gap-1 ${i === 4 ? 'bg-pink-50 dark:bg-pink-900/20' : 'bg-zinc-50 dark:bg-zinc-900/30'}`}>
            <span class="text-[8px] text-zinc-400">{i + 1}</span>
            {i % 3 === 0 && <div class="h-1.5 w-full rounded-sm bg-pink-400 mockup-item" style={`animation-delay: ${0.2 + i * 0.05}s`}></div>}
            {i % 4 === 0 && <div class="h-1.5 w-3/4 rounded-sm bg-purple-400 mockup-item" style={`animation-delay: ${0.3 + i * 0.05}s`}></div>}
          </div>
        ))}
      </div>
      
      <div class="mt-5 space-y-3">
        <div class="flex items-center gap-2 mb-2">
           <div class="h-2 w-2 rounded-full bg-pink-500"></div>
           <div class="h-3 w-20 rounded bg-zinc-300 dark:bg-zinc-600"></div>
        </div>
        {issueHighlights && issueHighlights.slice(0, 2).map((_: any, idx: number) => (
          <div class="mockup-item flex items-center gap-3 rounded-lg border border-zinc-100 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-2 shadow-sm" style={`animation-delay: ${0.8 + idx * 0.2}s; opacity: 0; animation-fill-mode: forwards;`}>
            <div class="h-10 w-10 rounded bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center">
              <div class="h-4 w-4 rounded-full bg-pink-400"></div>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-3/4 rounded bg-zinc-700 dark:bg-zinc-300"></div>
              <div class="mt-1.5 h-2 w-1/2 rounded bg-zinc-300 dark:bg-zinc-600"></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
