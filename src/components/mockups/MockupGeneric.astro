---
---
<div class="relative flex h-[400px] w-full items-center justify-center lg:justify-end">
  {/* Glow Effects */}
  <div class="pointer-events-none absolute -right-10 -top-10 h-64 w-64 rounded-full bg-brand/20 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-56 w-56 rounded-full bg-emerald-400/20 blur-3xl"></div>
  <div class="pointer-events-none absolute right-20 top-20 h-48 w-48 rounded-full bg-amber-400/20 blur-3xl"></div>
  
  {/* Center Platform Base */}
  <div class="absolute z-0 h-40 w-40 rounded-full border border-zinc-200/50 dark:border-zinc-800 bg-white/50 dark:bg-zinc-900/50 shadow-2xl backdrop-blur-md"></div>
  <div class="absolute z-0 h-56 w-56 animate-[spin_20s_linear_infinite] rounded-full border border-dashed border-zinc-300 dark:border-zinc-700"></div>
  <div class="absolute z-0 h-72 w-72 animate-[spin_30s_linear_infinite_reverse] rounded-full border border-zinc-200 dark:border-zinc-800"></div>

  {/* Floating Elements (Services) */}
  
  {/* Web App */}
  <div class="service-float absolute -left-4 top-10 z-20 rounded-2xl border border-blue-100 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4 shadow-xl">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 dark:bg-blue-900/40 text-brand">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/></svg>
      </div>
      <div>
        <div class="h-2.5 w-16 rounded-sm bg-zinc-800 dark:bg-zinc-200"></div>
        <div class="mt-2 h-1.5 w-24 rounded-sm bg-zinc-300 dark:bg-zinc-700"></div>
      </div>
    </div>
  </div>

  {/* Marketing */}
  <div class="service-float absolute -right-2 bottom-12 z-20 rounded-2xl border border-amber-100 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4 shadow-xl" style="animation-delay: 1.2s;">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 dark:bg-amber-900/40 text-amber-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
      </div>
      <div>
        <div class="h-2.5 w-12 rounded-sm bg-zinc-800 dark:bg-zinc-200"></div>
        <div class="mt-2 h-1.5 w-20 rounded-sm bg-zinc-300 dark:bg-zinc-700"></div>
      </div>
    </div>
  </div>

  {/* Social Media */}
  <div class="service-float absolute left-8 bottom-4 z-20 rounded-2xl border border-pink-100 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4 shadow-xl" style="animation-delay: 2.5s;">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-pink-100 dark:bg-pink-900/40 text-pink-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      </div>
      <div>
        <div class="h-2.5 w-14 rounded-sm bg-zinc-800 dark:bg-zinc-200"></div>
        <div class="mt-2 h-1.5 w-16 rounded-sm bg-zinc-300 dark:bg-zinc-700"></div>
      </div>
    </div>
  </div>
  
  {/* Main Device / Center Hub */}
  <div class="relative z-10 flex h-[240px] w-[240px] flex-col overflow-hidden rounded-[2rem] border border-zinc-200/80 dark:border-zinc-700 bg-white dark:bg-zinc-950 p-5 shadow-[0_20px_50px_rgba(0,0,0,0.1)]">
    <div class="mb-4 flex items-center justify-between">
      <div class="h-3 w-16 rounded bg-brand/20 dark:bg-brand/30"></div>
      <div class="service-live-dot h-2 w-2 rounded-full bg-emerald-500"></div>
    </div>
    <div class="flex-1 space-y-3">
      <div class="flex items-center gap-2">
         <div class="h-8 w-8 rounded-full bg-brand/10 dark:bg-brand/20"></div>
         <div class="h-2 w-full rounded bg-zinc-100 dark:bg-zinc-800">
           <div class="service-signal-bar h-full rounded bg-brand" style="--bar-width: 85%; --bar-delay: 0.2s;"></div>
         </div>
      </div>
      <div class="flex items-center gap-2">
         <div class="h-8 w-8 rounded-full bg-amber-100 dark:bg-amber-900/30"></div>
         <div class="h-2 w-full rounded bg-zinc-100 dark:bg-zinc-800">
           <div class="service-signal-bar h-full rounded bg-amber-400" style="--bar-width: 65%; --bar-delay: 0.4s;"></div>
         </div>
      </div>
      <div class="flex items-center gap-2">
         <div class="h-8 w-8 rounded-full bg-pink-100 dark:bg-pink-900/30"></div>
         <div class="h-2 w-full rounded bg-zinc-100 dark:bg-zinc-800">
           <div class="service-signal-bar h-full rounded bg-pink-400" style="--bar-width: 75%; --bar-delay: 0.6s;"></div>
         </div>
      </div>
      <div class="flex items-center gap-2">
         <div class="h-8 w-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30"></div>
         <div class="h-2 w-full rounded bg-zinc-100 dark:bg-zinc-800">
           <div class="service-signal-bar h-full rounded bg-emerald-400" style="--bar-width: 90%; --bar-delay: 0.8s;"></div>
         </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes service-bar-grow {
    from { width: 0; opacity: 0.45; }
    to { width: var(--bar-width); opacity: 1; }
  }
  @keyframes service-pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.7); }
  }
  @keyframes service-float-badge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .service-signal-bar {
    width: var(--bar-width);
    animation: service-bar-grow 0.9s ease-out both;
    animation-delay: var(--bar-delay, 0s);
  }
  .service-live-dot {
    animation: service-pulse-dot 1.6s ease-in-out infinite;
  }
  .service-float {
    animation: service-float-badge 3.6s ease-in-out infinite;
  }
</style>
