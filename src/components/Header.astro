---
import Button from './Button.astro';
import { services } from '@data/site';
import { servicePath } from '@data/routes';

const nav = [
  { label: 'Tentang', href: '/about' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Kontak', href: '/contact' },
];
---

<header class="sticky top-0 z-50 border-b border-zinc-200/80 dark:border-zinc-800 bg-white/90 backdrop-blur dark:bg-zinc-950/90">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Navigasi utama">
    <a href="/" class="flex items-center gap-3 font-bold tracking-tight text-zinc-950 dark:text-white" aria-label="jasamurahweb.com home">
      <img src="/logo-jasamurabweb.png" alt="Logo jasamurahweb.com" width="160" height="30" loading="eager" decoding="async" class="h-10 w-auto rounded-xl bg-[#ffffff] p-1" />
    </a>

    <div class="hidden items-center gap-7 md:flex">
      <a class="text-sm font-medium text-zinc-600 dark:text-zinc-400 transition hover:text-brand" href="/">Home</a>
      <div class="group relative">
        <a class="inline-flex items-center gap-1 text-sm font-medium text-zinc-600 dark:text-zinc-400 transition hover:text-brand" href="/services/">
          Layanan
          <svg aria-hidden="true" class="h-4 w-4 transition group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </a>
        <div class="invisible absolute left-1/2 top-full w-80 -translate-x-1/2 pt-4 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white p-3 shadow-[0_18px_60px_rgba(0,82,204,0.16)] dark:bg-zinc-950">
            <a class="block rounded-xl px-4 py-3 text-sm font-semibold text-zinc-950 dark:text-white hover:bg-brand-50 dark:hover:bg-zinc-900 hover:text-brand" href="/services/">Semua Layanan</a>
            {services.map((service) => (
              <a class="block rounded-xl px-4 py-3 text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:bg-brand-50 dark:hover:bg-zinc-900 hover:text-brand" href={servicePath(service.slug)}>{service.title}</a>
            ))}
          </div>
        </div>
      </div>
      {nav.map((item) => (
        <a class="text-sm font-medium text-zinc-600 dark:text-zinc-400 transition hover:text-brand" href={item.href}>{item.label}</a>
      ))}
      <button
        class="inline-flex h-10 items-center justify-center gap-2 rounded-xl border border-zinc-300 dark:border-zinc-700 px-3 text-sm font-semibold text-zinc-700 dark:text-zinc-300 transition hover:border-brand hover:text-brand"
        type="button"
        aria-label="Ganti dark mode light mode"
        data-theme-toggle
      >
        <svg aria-hidden="true" class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3v2M12 19v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M3 12h2M19 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
        <svg aria-hidden="true" class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
        <span data-theme-label>Light</span>
      </button>
      <Button href="/contact" class="py-2.5">Konsultasi Gratis</Button>
    </div>

    <button
      class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-300 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 md:hidden"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <span class="sr-only">Buka menu</span>
      <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 py-4 md:hidden" data-menu>
    <div class="flex flex-col gap-3">
      <a class="rounded-xl px-2 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-brand-50 dark:hover:bg-zinc-900 hover:text-brand" href="/">Home</a>
      <a class="rounded-xl px-2 py-2 text-sm font-semibold text-zinc-950 dark:text-white hover:bg-brand-50 dark:hover:bg-zinc-900 hover:text-brand" href="/services/">Layanan</a>
      <div class="grid gap-1 border-l border-zinc-200 dark:border-zinc-800 pl-3">
        {services.map((service) => (
          <a class="rounded-xl px-2 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-brand-50 dark:hover:bg-zinc-900 hover:text-brand" href={servicePath(service.slug)}>{service.title}</a>
        ))}
      </div>
      {nav.map((item) => (
        <a class="rounded-xl px-2 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-brand-50 dark:hover:bg-zinc-900 hover:text-brand" href={item.href}>{item.label}</a>
      ))}
      <button class="rounded-xl border border-zinc-300 dark:border-zinc-700 px-2 py-2 text-left text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:border-brand hover:text-brand" type="button" data-theme-toggle>
        Mode: <span data-theme-label>Light</span>
      </button>
      <Button href="/contact" class="mt-1">Konsultasi Gratis</Button>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector('[data-menu-button]');
  const menu = document.querySelector('[data-menu]');

  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('hidden', isOpen);
  });

  const applyTheme = (theme: 'light' | 'dark') => {
    const isDark = theme === 'dark';
    document.documentElement.classList.toggle('dark', isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    document.querySelectorAll('[data-theme-label]').forEach((label) => {
      label.textContent = isDark ? 'Dark' : 'Light';
    });
  };

  applyTheme(document.documentElement.classList.contains('dark') ? 'dark' : 'light');

  document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      applyTheme(nextTheme);
    });
  });
</script>
