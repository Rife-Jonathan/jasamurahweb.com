---
import Button from './Button.astro';
import { services } from '@data/site';
import { servicePath } from '@data/routes';

const nav = [
  { label: 'Tentang', href: '/about/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Kontak', href: '/contact/' },
];
---

<header class="sticky top-0 z-50 px-3 pt-3">
  <nav class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-white/70 bg-white/[0.82] px-4 py-3 shadow-[0_18px_60px_rgba(15,23,42,0.10)] backdrop-blur-2xl dark:border-white/10 dark:bg-zinc-950/[0.78]" aria-label="Navigasi utama">
    <a href="/" class="flex items-center gap-3 font-bold tracking-tight text-zinc-950 dark:text-white" aria-label="jasamurahweb.com home">
      <img src="/logo-jasamurabweb.png" alt="Logo jasamurahweb.com" width="160" height="30" loading="eager" decoding="async" class="h-9 w-auto rounded-full bg-white px-2 py-1" />
    </a>

    <div class="hidden items-center gap-6 md:flex">
      <a class="text-sm font-semibold text-zinc-600 transition hover:text-brand dark:text-zinc-300" href="/">Home</a>
      <div class="group relative">
        <a class="inline-flex items-center gap-1 text-sm font-semibold text-zinc-600 transition hover:text-brand dark:text-zinc-300" href="/services/">
          Layanan
          <svg aria-hidden="true" class="h-4 w-4 transition group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </a>
        <div class="invisible absolute left-1/2 top-full w-80 -translate-x-1/2 pt-4 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="rounded-[1.5rem] border border-white/70 bg-white/[0.92] p-3 shadow-[0_24px_80px_rgba(15,23,42,0.14)] backdrop-blur-2xl dark:border-white/10 dark:bg-zinc-950/[0.95]">
            <a class="block rounded-2xl px-4 py-3 text-sm font-bold text-zinc-950 hover:bg-brand-50 hover:text-brand dark:text-white dark:hover:bg-white/10" href="/services/">Semua Layanan</a>
            {services.map((service) => (
              <a class="block rounded-2xl px-4 py-3 text-sm font-semibold text-zinc-600 hover:bg-brand-50 hover:text-brand dark:text-zinc-300 dark:hover:bg-white/10" href={servicePath(service.slug)}>{service.title}</a>
            ))}
          </div>
        </div>
      </div>
      {nav.map((item) => (
        <a class="text-sm font-semibold text-zinc-600 transition hover:text-brand dark:text-zinc-300" href={item.href}>{item.label}</a>
      ))}
      <button
        class="inline-flex h-10 items-center justify-center gap-2 rounded-full border border-zinc-200 bg-white/[0.65] px-3 text-sm font-bold text-zinc-700 shadow-sm transition hover:border-brand/50 hover:text-brand dark:border-white/10 dark:bg-white/[0.06] dark:text-zinc-200"
        type="button"
        aria-label="Ganti dark mode light mode"
        data-theme-toggle
      >
        <svg aria-hidden="true" class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3v2M12 19v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M3 12h2M19 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
        <svg aria-hidden="true" class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
        <span data-theme-label>Light</span>
      </button>
      <Button href="/contact/" class="py-2.5">Konsultasi Gratis</Button>
    </div>

    <button
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-zinc-200 bg-white/70 text-zinc-800 shadow-sm md:hidden dark:border-white/10 dark:bg-white/[0.06] dark:text-zinc-200"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <span class="sr-only">Buka menu</span>
      <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </nav>
  <div id="mobile-menu" class="mx-auto mt-2 hidden max-w-6xl rounded-[1.5rem] border border-white/70 bg-white/[0.92] px-4 py-4 shadow-premium backdrop-blur-2xl md:hidden dark:border-white/10 dark:bg-zinc-950/[0.95]" data-menu>
    <div class="flex flex-col gap-3">
      <a class="rounded-2xl px-3 py-2 text-sm font-semibold text-zinc-700 hover:bg-brand-50 hover:text-brand dark:text-zinc-300 dark:hover:bg-white/10" href="/">Home</a>
      <a class="rounded-2xl px-3 py-2 text-sm font-bold text-zinc-950 hover:bg-brand-50 hover:text-brand dark:text-white dark:hover:bg-white/10" href="/services/">Layanan</a>
      <div class="grid gap-1 border-l border-zinc-200 pl-3 dark:border-white/10">
        {services.map((service) => (
          <a class="rounded-2xl px-3 py-2 text-sm font-semibold text-zinc-700 hover:bg-brand-50 hover:text-brand dark:text-zinc-300 dark:hover:bg-white/10" href={servicePath(service.slug)}>{service.title}</a>
        ))}
      </div>
      {nav.map((item) => (
        <a class="rounded-2xl px-3 py-2 text-sm font-semibold text-zinc-700 hover:bg-brand-50 hover:text-brand dark:text-zinc-300 dark:hover:bg-white/10" href={item.href}>{item.label}</a>
      ))}
      <button class="rounded-full border border-zinc-200 px-3 py-2 text-left text-sm font-semibold text-zinc-700 hover:border-brand/50 hover:text-brand dark:border-white/10 dark:text-zinc-300" type="button" data-theme-toggle>
        Mode: <span data-theme-label>Light</span>
      </button>
      <Button href="/contact/" class="mt-1">Konsultasi Gratis</Button>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector('[data-menu-button]');
  const menu = document.querySelector('[data-menu]');

  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('hidden', isOpen);
  });

  const applyTheme = (theme: 'light' | 'dark') => {
    const isDark = theme === 'dark';
    document.documentElement.classList.toggle('dark', isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    document.querySelectorAll('[data-theme-label]').forEach((label) => {
      label.textContent = isDark ? 'Dark' : 'Light';
    });
  };

  applyTheme(document.documentElement.classList.contains('dark') ? 'dark' : 'light');

  document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      applyTheme(nextTheme);
    });
  });
</script>
