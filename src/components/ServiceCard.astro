---
interface Props {
  title: string;
  summary: string;
  slug: string;
  icon?: string;
}

const { title, summary, slug } = Astro.props;
---

<article class="group flex h-full flex-col rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-6 shadow-sm transition hover:-translate-y-1 hover:border-brand/40 dark:hover:border-brand/40 hover:shadow-[0_18px_60px_rgba(0,82,204,0.16)] dark:hover:shadow-[0_18px_60px_rgba(0,82,204,0.1)]">
  <div class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 dark:bg-brand-900/20 text-brand dark:text-blue-400">
    <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Z"></path>
      <path d="M8 8h8M8 12h8M8 16h5"></path>
    </svg>
  </div>
  <h3 class="mt-5 text-xl font-bold tracking-tight text-zinc-950 dark:text-white">{title}</h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{summary}</p>
  <a href={`/services/${slug}/`} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand dark:text-blue-400">
    Selengkapnya
    <span aria-hidden="true" class="transition group-hover:translate-x-1">-&gt;</span>
  </a>
</article>
