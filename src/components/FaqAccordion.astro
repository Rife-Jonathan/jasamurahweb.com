---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-zinc-200 dark:divide-zinc-800 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50">
  {items.map((item, index) => (
    <details class="group p-5" open={index === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-zinc-950 dark:text-white">
        {item.question}
        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-xl bg-brand-50 dark:bg-brand-900/20 text-brand dark:text-blue-400 transition group-open:rotate-45">+</span>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{item.answer}</p>
    </details>
  ))}
</div>
