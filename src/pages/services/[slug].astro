---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import FaqAccordion from '@components/FaqAccordion.astro';
import { contact } from '@data/site';

import MockupWebsite from '@components/mockups/MockupWebsite.astro';
import MockupApp from '@components/mockups/MockupApp.astro';
import MockupMarketing from '@components/mockups/MockupMarketing.astro';
import MockupSocial from '@components/mockups/MockupSocial.astro';
import MockupCompany from '@components/mockups/MockupCompany.astro';
import MockupGeneric from '@components/mockups/MockupGeneric.astro';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const siteUrl = 'https://www.jasamurahweb.com';
const serviceUrl = `${siteUrl}/services/${entry.id}/`;

const briefMessage = `Halo tim jasamurahweb, saya ingin ajukan brief untuk layanan ${entry.data.title}. Bisa bantu konsultasi langkah awalnya?`;
const briefHref = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(briefMessage)}`;
const issueLevels = ['Kritis', 'Waspada', 'Prioritas'];
const issueBarWidths = ['88%', '76%', '92%'];
const issueHighlights = entry.data.frictionPoints.slice(0, 3).map((point, index) => ({
  text: point.length > 86 ? `${point.slice(0, 83).trimEnd()}...` : point,
  level: issueLevels[index] ?? 'Prioritas',
  width: issueBarWidths[index] ?? '70%',
  delay: `${0.15 * (index + 1)}s`,
}));

/** Service schema untuk rich results dan konteks komersial di Google */
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": entry.data.title,
  "description": entry.data.description,
  "url": serviceUrl,
  "provider": {
    "@type": "LocalBusiness",
    "name": "jasamurahweb.com",
    "url": siteUrl,
    "telephone": contact.whatsappDisplay,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Sleman",
      "addressRegion": "Yogyakarta",
      "addressCountry": "ID"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Yogyakarta" },
    { "@type": "Country", "name": "Indonesia" }
  ]
};

/** BreadcrumbList schema untuk navigasi hirarkis di SERP */
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Layanan", "item": `${siteUrl}/services/` },
    { "@type": "ListItem", "position": 3, "name": entry.data.title, "item": serviceUrl }
  ]
};
---

<BaseLayout
  title={`${entry.data.title} | jasamurahweb.com`}
  description={entry.data.description}
  ogImage="/services_visual_blue.png"
  canonicalUrl={serviceUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  <section class="bg-white dark:bg-zinc-950 py-20">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_0.8fr] lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{entry.data.eyebrow}</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-6xl">{entry.data.headline}</h1>
        <p class="mt-6 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">{entry.data.description}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={briefHref}>Ajukan Brief</Button>
          <Button href="#pertanyaan-umum" variant="secondary">Lihat Pertanyaan Umum</Button>
        </div>
      </div>
      <aside class="relative flex items-center justify-center lg:justify-end">
        {entry.id === 'jasa-pembuatan-website' && <MockupWebsite issueHighlights={issueHighlights} />}
        {entry.id === 'jasa-aplikasi-web-dan-android' && <MockupApp issueHighlights={issueHighlights} />}
        {entry.id === 'jasa-iklan-di-meta-dan-google' && <MockupMarketing issueHighlights={issueHighlights} />}
        {entry.id === 'jasa-pembuatan-konten-sosmed' && <MockupSocial issueHighlights={issueHighlights} />}
        {entry.id === 'jasa-pembuatan-company-profile' && <MockupCompany issueHighlights={issueHighlights} />}
        {![
          'jasa-pembuatan-website', 
          'jasa-aplikasi-web-dan-android', 
          'jasa-iklan-di-meta-dan-google', 
          'jasa-pembuatan-konten-sosmed', 
          'jasa-pembuatan-company-profile'
        ].includes(entry.id) && <MockupGeneric />}
      </aside>
    </div>
  </section>

  <section class="border-y border-zinc-200 bg-brand-50 py-20 text-zinc-950 dark:border-zinc-800 dark:bg-zinc-950 dark:text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand dark:text-blue-300">Biaya yang sering tidak terlihat</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{entry.data.challengeHeading}</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {entry.data.frictionPoints.map((item) => (
          <div class="rounded-xl border border-blue-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5">
            <p class="text-lg font-bold leading-relaxed">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-zinc-950 py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1fr] lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Cara kami membantu</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-4xl">{entry.data.solutionHeading}</h2>
        <div class="prose prose-blue dark:prose-invert mt-6 max-w-none text-zinc-600 dark:text-zinc-400">
          <Content />
        </div>
      </div>
      <div class="grid gap-4">
        {entry.data.featuresList.map((feature) => (
          <div class="flex gap-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-5 shadow-sm">
            <span class="mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand text-xs font-bold text-white">✓</span>
            <p class="font-semibold leading-relaxed text-zinc-800 dark:text-zinc-200">{feature}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-50 dark:bg-zinc-900/30 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Bukti yang bisa diukur</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-4xl">{entry.data.proofHeading}</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {entry.data.proofItems.map((item) => (
          <article class="rounded-xl border border-blue-100 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-6">
            <h3 class="text-xl font-bold text-zinc-950 dark:text-white">{item.title}</h3>
            <p class="mt-5 text-sm leading-relaxed text-zinc-700 dark:text-zinc-400"><strong class="text-3xl text-zinc-950 dark:text-white">{item.metric}</strong> {item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-zinc-950 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-4xl">{entry.data.processHeading}</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {entry.data.processItems.map((item) => (
          <article class="border-l-2 border-brand pl-5">
            <p class="text-sm font-bold text-brand">{item.step}</p>
            <h3 class="mt-2 text-xl font-bold text-zinc-950 dark:text-white">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="pertanyaan-umum" class="bg-brand-50 dark:bg-zinc-900/30 py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1fr] lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Sebelum bekerja sama</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white">Pertanyaan yang sering diajukan.</h2>
      </div>
      <FaqAccordion items={entry.data.faqItems} />
    </div>
  </section>

  <section class="bg-brand py-16 text-white">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-4 sm:px-6 md:flex-row md:items-center lg:px-8">
      <div>
        <h2 class="text-3xl font-extrabold tracking-tight">{entry.data.ctaHeading}</h2>
        <p class="mt-3 max-w-2xl text-blue-100">{entry.data.ctaText}</p>
      </div>
      <Button href={briefHref} variant="light" class="shrink-0">Ajukan Brief</Button>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes service-bar-grow {
    from {
      width: 0;
      opacity: 0.45;
    }
    to {
      width: var(--bar-width);
      opacity: 1;
    }
  }

  @keyframes service-pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.7);
    }
  }

  @keyframes service-float-badge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  .service-signal-bar {
    width: var(--bar-width);
    animation: service-bar-grow 0.9s ease-out both;
    animation-delay: var(--bar-delay, 0s);
  }

  .service-live-dot {
    animation: service-pulse-dot 1.6s ease-in-out infinite;
  }

  .service-float {
    animation: service-float-badge 3.2s ease-in-out infinite;
  }

  @keyframes mockup-fade-in-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mockup-item {
    animation: mockup-fade-in-up 0.5s ease-out forwards;
  }
</style>
