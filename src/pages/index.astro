---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { portfolio, processSteps, services, techStack, testimonials, contact } from '@data/site';

import MockupWebsite from '@components/mockups/MockupWebsite.astro';
import MockupApp from '@components/mockups/MockupApp.astro';
import MockupMarketing from '@components/mockups/MockupMarketing.astro';
import MockupGeneric from '@components/mockups/MockupGeneric.astro';

const briefMessage = `Halo jasamurahweb.com, saya melihat contoh proyek di website dan tertarik untuk membahas proyek yang serupa.`;
const briefHref = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(briefMessage)}`;

/** JSON-LD LocalBusiness schema untuk sinyal lokal Yogyakarta */
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "jasamurahweb.com",
  "description": "Agensi digital end-to-end di Yogyakarta untuk pembuatan website, aplikasi, company profile, konten sosial media, dan iklan Meta Google yang terukur.",
  "url": "https://jasamurahweb.com",
  "logo": "https://jasamurahweb.com/logo-jasamurabweb.png",
  "image": "https://jasamurahweb.com/home_visual_blue.png",
  "telephone": contact.whatsappDisplay,
  "email": contact.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Jl. Candi Gebang permai blok 6 no 2 Jetis, Wedomartani",
    "addressLocality": "Sleman",
    "addressRegion": "Yogyakarta",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -7.7273,
    "longitude": 110.4067
  },
  "areaServed": [
    { "@type": "City", "name": "Yogyakarta" },
    { "@type": "City", "name": "Sleman" },
    { "@type": "City", "name": "Bantul" },
    { "@type": "Country", "name": "Indonesia" }
  ],
  "sameAs": [
    contact.instagram,
    contact.facebook
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "09:00",
    "closes": "18:00"
  },
  "priceRange": "Rp5.000.000+"
};
---

<BaseLayout
  title="Agensi Digital Yogyakarta — Website, Aplikasi & Iklan | jasamurahweb"
  description="Agensi digital di Yogyakarta untuk pembuatan website, aplikasi, company profile, konten sosial media, dan iklan Meta Google yang terukur."
  ogImage="/home_visual_blue.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} is:inline />

  <section class="overflow-hidden bg-white dark:bg-zinc-950">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Digital growth partner</p>
        <h1 class="mt-5 max-w-4xl text-4xl font-extrabold leading-tight tracking-tight text-zinc-950 dark:text-white sm:text-5xl lg:text-6xl">
          Transformasi Kehadiran Digital Bisnis Anda Bersama jasamurahweb.com.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
          Kami membangun website premium, aplikasi, dan strategi marketing yang menghasilkan pertumbuhan nyata. Agensi digital end-to-end untuk scale-up bisnis Anda tanpa biaya overhead yang membingungkan. Cepat, transparan, dan berorientasi hasil.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact/">Konsultasi Gratis Sekarang</Button>
          <Button href="/services/" variant="secondary">Lihat Layanan Kami</Button>
        </div>
        <p class="mt-6 text-sm font-medium text-zinc-700 dark:text-zinc-400">★★★★★ Dipercaya oleh 50+ pemilik bisnis dan brand di Indonesia.</p>
      </div>
      <div class="relative flex items-center justify-center lg:justify-end">
        <div class="absolute -inset-4 rounded-[3rem] bg-brand-50/80 dark:bg-brand-900/20 blur-2xl"></div>
        <img
          src="/home_visual_blue.png"
          alt="Keberhasilan Digital Bersama jasamurahweb.com"
          width="800"
          height="600"
          fetchpriority="high"
          class="relative w-full max-w-2xl rounded-2xl object-contain drop-shadow-2xl shadow-blue-900/20 dark:shadow-black/50"
          style="animation: float 6s ease-in-out infinite;"
        />
      </div>
    </div>
  </section>

  <section class="border-y border-zinc-200 dark:border-zinc-800 bg-brand-50 dark:bg-zinc-900/30 py-6">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-4 px-4 text-sm font-semibold text-zinc-500 sm:px-6 lg:px-8">
      {techStack.map((item) => <span class="grayscale transition hover:grayscale-0">{item}</span>)}
    </div>
  </section>

  <section class="bg-white dark:bg-zinc-950 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Layanan utama</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-4xl">Lima pilar digital untuk membuat bisnis lebih mudah dipercaya dan dibeli.</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="border-y border-zinc-200 bg-brand-50 py-20 text-zinc-950 dark:border-zinc-800 dark:bg-zinc-900/30 dark:text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand dark:text-blue-300">Cara kerja</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Dari hambatan bisnis menuju aset digital yang bisa diukur.</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-4">
        {processSteps.map((item) => (
          <article class="border-l border-brand/40 pl-5 dark:border-blue-400/40">
            <p class="text-sm font-bold text-brand dark:text-blue-300">{item.step}</p>
            <h3 class="mt-3 text-xl font-bold dark:text-white">{item.title}</h3>
            <p class="mt-1 text-sm font-semibold text-zinc-700 dark:text-zinc-300">{item.label}</p>
            <p class="mt-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-zinc-950 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Contoh hasil kerja</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-4xl">Contoh proyek yang menghubungkan desain, teknologi, dan hasil bisnis.</h2>
        </div>
        <Button href={briefHref} variant="secondary">Bahas Projek Serupa</Button>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {portfolio.map((item) => (
          <article class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-6 shadow-sm">
            <div class="relative flex aspect-[16/10] items-center justify-center overflow-hidden rounded-xl bg-[linear-gradient(135deg,#0052CC_0%,#101828_100%)] p-4">
              <div class="absolute inset-0 flex items-center justify-center scale-[0.55] origin-center">
                {item.category === 'Website' && <MockupWebsite issueHighlights={[]} />}
                {item.category === 'Aplikasi' && <MockupApp issueHighlights={[]} />}
                {item.category === 'Iklan' && <MockupMarketing issueHighlights={[]} />}
                {item.category !== 'Website' && item.category !== 'Aplikasi' && item.category !== 'Iklan' && <MockupGeneric />}
              </div>
            </div>
            <p class="mt-5 text-xs font-semibold uppercase tracking-[0.18em] text-brand">{item.category}</p>
            <h3 class="mt-2 text-xl font-bold text-zinc-950 dark:text-white">{item.title}</h3>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{item.industry}</p>
            <p class="mt-5 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300"><strong class="text-3xl tracking-tight text-zinc-950 dark:text-white">{item.metric}</strong> {item.result}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-50 dark:bg-zinc-900/30 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Cerita klien</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-4xl">Dipilih karena proses yang jelas dan output yang bisa dipakai tim bisnis.</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {testimonials.map((item) => (
          <figure class="rounded-xl border border-blue-100 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-6 shadow-sm">
            <blockquote class="text-base leading-relaxed text-zinc-700 dark:text-zinc-300">"{item.quote}"</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="grid h-11 w-11 place-items-center rounded-full bg-brand text-sm font-bold text-white">{item.name.charAt(0)}</span>
              <span>
                <span class="block font-semibold text-zinc-950 dark:text-white">{item.name}</span>
                <span class="block text-sm text-zinc-500 dark:text-zinc-400">{item.role}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand py-16 text-white">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-4 sm:px-6 md:flex-row md:items-center lg:px-8">
      <h2 class="max-w-3xl text-3xl font-extrabold tracking-tight sm:text-5xl">Siap Menguasai Pasar Digital? Mari Mulai Projek Anda Hari Ini.</h2>
      <Button href="/contact/" variant="light" class="shrink-0">Mulai Konsultasi</Button>
    </div>
  </section>
</BaseLayout>

