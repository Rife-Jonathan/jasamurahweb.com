---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import { contact } from '@data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = Math.max(1, Math.ceil((post.body ?? '').length / 900));
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;

const siteUrl = 'https://www.jasamurahweb.com';
const postUrl = `${siteUrl}/blog/${post.data.slug}/`;

/** Article schema — author sebagai Organization untuk E-E-A-T entity linking */
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${postUrl}#article`,
  "headline": post.data.title,
  "description": post.data.description,
  "url": postUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl },
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  "wordCount": wordCount,
  "inLanguage": "id-ID",
  "author": {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": post.data.author,
    "url": `${siteUrl}/about/`,
  },
  "publisher": { "@id": `${siteUrl}/#organization` },
  ...(post.data.heroImage && {
    "image": {
      "@type": "ImageObject",
      "url": `${siteUrl}${post.data.heroImage}`,
      "width": 1200,
      "height": 600,
    }
  })
};

/** BreadcrumbList schema untuk navigasi hirarkis di SERP */
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${postUrl}#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog/` },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": postUrl }
  ]
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": postUrl,
  "url": postUrl,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "h2", ".prose p:first-of-type"],
  },
};

const briefMessage = `Halo jasamurahweb.com, saya baru saja membaca artikel "${post.data.title}" dan tertarik untuk diskusi lebih lanjut mengenai bisnis saya.`;
const briefHref = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(briefMessage)}`;

const ogImageUrl = post.data.heroImage ? String(post.data.heroImage) : '/home_visual_blue.png';
---

<BaseLayout
  title={`${post.data.title} | Blog jasamurahweb.com`}
  description={post.data.description}
  ogImage={ogImageUrl}
  canonicalUrl={postUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} is:inline />

  <article class="bg-white dark:bg-zinc-950 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[250px_minmax(0,1fr)_250px] items-start">
        
        <aside class="sticky top-32 hidden lg:block lg:order-1">
          <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 p-5">
            <h3 class="font-bold text-zinc-950 dark:text-white">Daftar Isi</h3>
            <ul class="mt-4 space-y-2 text-sm">
              {headings.map((heading) => (
                <li class={heading.depth === 2 ? "" : heading.depth === 3 ? "pl-3" : heading.depth === 4 ? "pl-6" : "pl-9"}>
                  <a href={`#${heading.slug}`} class="text-zinc-600 dark:text-zinc-400 hover:text-brand dark:hover:text-blue-400">{heading.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <div class="min-w-0 lg:order-2">
          <nav aria-label="Breadcrumb" class="flex text-sm text-zinc-500 dark:text-zinc-400">
            <ol class="flex items-center space-x-2">
              <li><a href="/" class="hover:text-brand dark:hover:text-blue-400 transition-colors">Home</a></li>
              <li><span class="mx-1">/</span></li>
              <li><a href="/blog/" class="hover:text-brand dark:hover:text-blue-400 transition-colors">Blog</a></li>
              <li><span class="mx-1">/</span></li>
              <li class="text-zinc-900 dark:text-zinc-100 truncate" aria-current="page">{post.data.title}</li>
            </ol>
          </nav>

          <header class="mt-8">
            <p class="text-sm text-zinc-500 dark:text-zinc-400">{post.data.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })} · {readingTime} menit baca · {post.data.author}</p>
            <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">{post.data.title}</h1>
          </header>
          
          {/* Hero image: gunakan heroImage dari frontmatter jika ada, fallback ke gradient */}
          {post.data.heroImage ? (
            <img
              src={String(post.data.heroImage)}
              alt={post.data.title}
              width="1200"
              height="600"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="mt-10 w-full rounded-xl object-cover aspect-[2/1]"
            />
          ) : (
            <div class="mt-10 aspect-[16/8] rounded-xl bg-[linear-gradient(135deg,#f0f5ff_0%,#0052CC_55%,#101828_100%)]"></div>
          )}
          
          <div class="mt-12 prose prose-blue dark:prose-invert max-w-none prose-headings:tracking-tight prose-p:leading-relaxed text-zinc-600 dark:text-zinc-400">
            <Content />
          </div>
          
          <div class="mt-16 rounded-2xl border border-blue-100 dark:border-zinc-800 bg-brand-50 dark:bg-zinc-900/50 p-8 text-center sm:p-12">
            <h2 class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-3xl">Butuh bantuan terapkan strategi ini?</h2>
            <p class="mt-4 text-zinc-600 dark:text-zinc-400">Tim jasamurahweb.com siap membantu bisnis Anda membangun aset digital yang menghasilkan pertumbuhan nyata.</p>
            <div class="mt-8 flex justify-center">
              <Button href={briefHref}>Diskusi dengan Tim Kami</Button>
            </div>
          </div>
        </div>

        <aside class="sticky top-32 hidden lg:block lg:order-3">
          <a href={briefHref} target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-sm transition-transform hover:-translate-y-1" aria-label="Hubungi jasamurahweb.com via WhatsApp">
            <img
              src="/banner-blog/promo-banner.png"
              alt="Konsultasi gratis dengan jasamurahweb.com"
              width="300"
              height="400"
              loading="lazy"
              class="w-full h-auto object-cover"
            />
          </a>
        </aside>


      </div>
    </div>
  </article>
</BaseLayout>



